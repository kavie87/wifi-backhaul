  printf '%s\n' "$copy_report" | sed 's/^/  /'
  if [ -f /root/dja-backhaul/sync-ssid ]; then
    echo "  Change that time under Management, Scheduled Tasks. Hour */6 and Minute 0 runs every 6 hours."
    case "$copy_report" in
      *"Pending"*) echo "  The scheduled task will retry at its next run." ;;
    esac
  fi
elif [ "$SYNC_ONCE" = y ]; then
  echo "  Wi-Fi synchronisation: One time"
  if [ ! -x /root/dja-backhaul/sync-upstream-ssid ]; then
    echo "  Initial Wi-Fi copy: Pending"
    echo "  Reason: Unable to retrieve the main modem's settings."
  else
    classify_copy "$sync_out" "$sync_code" /tmp/dja-backhaul/status-live | sed 's/^/  /'
  fi
fi
hidden_pending=n
[ -f /root/dja-backhaul/backhaul-bh ] && hidden_pending=y
if [ "$BOOSTER_CARD" = y ] || [ "$hidden_pending" = y ] || printf '%s\n' "$link_out" | grep -Eq 'Backhaul switched to|Could not read the hidden backhaul|hidden backhaul details were incomplete'; then
  classify_hidden "$link_out" "$hidden_pending" | sed 's/^/  /'
fi
if grep -v '^#' /etc/crontabs/root 2>/dev/null | grep -q mtd-backup; then
  echo "  USB backup: Scheduled task left as it is"
else
  echo "  USB backup: Listed under Scheduled Tasks and switched off"
fi
if ps w | grep -v grep | grep -q /root/dja-backhaul/web-control.sh; then
  echo "  Web control: Running"
else
  echo "  Web control: Not running"
fi
if [ "$replaced_web" = y ]; then
  echo "  A web-control.sh job from this shell stops when this run replaces it. The line above is the copy that is running now."
fi
echo "Next steps:"
if [ ! -s /root/dja-backhaul/ssid ] || [ ! -s /root/dja-backhaul/password ]; then
  echo "  Choose the upstream network in the Wi-Fi Backhaul card."
fi
printf '  Refresh http://%s/\n' "$LAN_IP"
if [ "$handover_done" != y ]; then
  echo "  Ethernet WAN preserved — configuring Wi-Fi backhaul."
  echo "  The WAN port becomes a LAN port after Wi-Fi backhaul is verified."
fi
