chmod 600 /root/dja-backhaul/ssid /root/dja-backhaul/password /root/dja-backhaul/bssid 2>/dev/null || true
find /root/dja-backhaul -name '*.sh' -o -name '*.lua' | while read -r script; do
  chmod 755 "$script"
done
chmod 755 /root/dja-backhaul/bin/* 2>/dev/null || true

cp "$tmp/init.dja-backhaul" /etc/init.d/dja-backhaul
