#!/bin/sh
# Wi-Fi backhaul installer for a Telstra DJA0231 that is already rooted,
# de-telstra'd, and running tch-gui-unhide.
#
#   chmod +x wifi-backhaul
#   ./wifi-backhaul -i 192.168.100.2 -y
#
# -i is the booster's own LAN address (the address you browse to).
# The upstream Wi-Fi name and password are not stored in this file.
# After it boots, choose the upstream network in the Wi-Fi Backhaul card.
# ./tch-gui-unhide -U -y keeps these pages. Run this installer again
# if you replace /root/tch-gui-unhide itself.

SCRIPT="$(basename "$0")"
GREEN='\033[1;32m'
ORANGE='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
cat <<EOH
Installs the Wi-Fi backhaul booster on this device.

Usage: ./$SCRIPT -i <lan-ip> [-y] [-n]

Options:
 -i <lan-ip>  IPv4 address of this booster on the main modem's LAN
 -y           Skip the confirmation prompt
 -n           Do not reboot when finished
 -t           Check the packaged files, then exit

Example:
  ./$SCRIPT -i 192.168.100.2 -y

Run this after reset-to-factory-defaults-with-root, de-telstra, and
tch-gui-unhide. The LAN address can be any address on that network.
192.168.100.2 is the address used on a 192.168.100.0 network.
EOH
exit 1
}

valid_ipv4() {
  echo "$1" | awk -F. '
    NF != 4 { exit 1 }
    {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/) exit 1
        if ($i < 0 || $i > 255) exit 1
      }
    }
  '
}

install_wrapper() {
  wrap=/root/tch-gui-unhide
  if [ ! -f "$wrap" ]; then
    echo -e "${ORANGE}No /root/tch-gui-unhide yet. Run the tch-gui-unhide get command first.${NC}"
    return 0
  fi
  if grep -q dja-backhaul-keep "$wrap"; then
    echo "Unhide upgrade will keep the booster pages."
    return 0
  fi
  mkdir -p /root/dja-backhaul/backups
  cp -p "$wrap" /root/dja-backhaul/backups/tch-gui-unhide.before-keep
  lua - "$wrap" <<'LUA'
local path = arg[1]
local f = io.open(path, "r")
local s = f:read("*a")
f:close()
if s:find("dja-backhaul-keep", 1, true) then
  os.exit(0)
end
local fn = [[
reapply_dja_backhaul() { # dja-backhaul-keep
  src=/root/dja-backhaul/tch-gui-unhide-xtra.dja-backhaul
  dst=/root/tch-gui-unhide-xtra.dja-backhaul
  if [ -f "$src" ] && [ ! -f "$dst" ]; then
    cp "$src" "$dst"
    chmod 755 "$dst"
  fi
  if [ -x /root/dja-backhaul/reapply-after-unhide.sh ]; then
    /root/dja-backhaul/reapply-after-unhide.sh >>/root/dja-backhaul/unhide-reapply.log 2>&1 || true
  fi
}

]]
local first = s:find("\n", 1, true)
if not first then
  io.stderr:write("wrapper has no newline\n")
  os.exit(1)
end
s = s:sub(1, first) .. fn .. s:sub(first + 1)
local out = {}
local n = 0
for line in (s .. "\n"):gmatch("(.-)\n") do
  n = n + 1
  out[n] = line
  if line:find("sh $SCRIPT -W", 1, true) then
    n = n + 1
    out[n] = "  reapply_dja_backhaul"
  end
end
local w = io.open(path, "w")
w:write(table.concat(out, "\n"))
if s:sub(-1) == "\n" then
  w:write("\n")
end
w:close()
LUA
  chmod 755 "$wrap"
  echo "Unhide upgrade will keep the booster pages."
}

LAN_IP=
YES=n
REBOOT=y
TEST=n
while getopts :i:nyt option; do
  case "$option" in
    i) LAN_IP=$OPTARG ;;
    n) REBOOT=n ;;
    y) YES=y ;;
    t) TEST=y ;;
    *) usage ;;
  esac
done

if [ "$TEST" != y ] && [ -z "$LAN_IP" ]; then
  echo -e "${RED}The booster LAN address is required. Example: -i 192.168.100.2${NC}"
  usage
fi
if [ -n "$LAN_IP" ] && ! valid_ipv4 "$LAN_IP"; then
  echo -e "${RED}Invalid LAN address: $LAN_IP${NC}"
  exit 1
fi
if [ "$(id -u)" != 0 ]; then
  echo -e "${RED}Run this as root on the booster.${NC}"
  exit 1
fi

tmp=/tmp/wifi-backhaul-unpack.$$
rm -rf "$tmp"
mkdir -p "$tmp"
