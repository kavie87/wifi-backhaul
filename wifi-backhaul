#!/bin/sh
# Wi-Fi backhaul installer for a Telstra DJA0231 that is already rooted,
# de-telstra'd, and running tch-gui-unhide.
#
#   chmod +x wifi-backhaul
#   ./wifi-backhaul -y
#
# The LAN address is the one already set by pre-booster.
# The upstream Wi-Fi name and password are not stored in this file.
# After it finishes, choose the upstream network in the Wi-Fi Backhaul card.
# ./tch-gui-unhide -U -y keeps these pages. Run ./wifi-backhaul -U -y
# to apply a newer copy of this installer without changing the saved
# upstream Wi-Fi, backhaul address, or this booster's LAN address.
# Run the full install again if you replace /root/tch-gui-unhide itself.

SCRIPT="$(basename "$0")"
GREEN='\033[1;32m'
ORANGE='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
cat <<EOH
Installs or updates the Wi-Fi backhaul booster on this device.

Usage: ./$SCRIPT [-y]
       ./$SCRIPT -b [-y]
       ./$SCRIPT -s [-y]
       ./$SCRIPT -S [-y]
       ./$SCRIPT -Sr [-y]
       ./$SCRIPT -U [-y]
       ./$SCRIPT -U -S [-y]
       ./$SCRIPT -bs [-y]
       ./$SCRIPT -U [-b] [-s] [-S] [-y]

Options:
 -U           Update an existing booster and keep its saved settings,
              including an hourly Wi-Fi check that is already enabled.
              Run -Sr on its own to remove that check.
 -b           Add the Wi-Fi Booster card. A later run keeps the card
              if it is already enabled
 -s           Copy the upstream 2.4 and 5 GHz names once
 -S           Keep those names in step, and check again every hour
 -Sr          Remove that hourly check. The current Wi-Fi name, password
              and network settings stay as they are.
 -y           Skip the confirmation prompt and keep saved values
 -t           Check the packaged files, then exit

Example:
  ./$SCRIPT -y
  ./$SCRIPT -b -y
  ./$SCRIPT -s -y
  ./$SCRIPT -S -y
  ./$SCRIPT -Sr
  ./$SCRIPT -bs -y
  ./$SCRIPT -U -y

-s copies the modem this booster is connected to, once. Its 2.4 GHz and
5 GHz client names and passwords become this booster's client names and
passwords. If that modem has band steering on, this booster turns band
steering on too. If the main modem is not connected, nothing is changed.
Run -s again when that link is up. The same Copy button is on the
Access Point form, under Protected Management Frames. -S does that copy
and then checks again every hour. Management, Scheduled Tasks, lists
that job. The time starts at once an hour and can be changed there.
-Sr removes only that hourly task. The Wi-Fi name already in use stays.
The backhaul network stays as it is. Do not combine -Sr with -U or
another install option. Run ./wifi-backhaul -Sr on its own. Running
./wifi-backhaul again keeps a check that is already enabled. -bs does the once
copy and then aims the backhaul at the main modem's hidden network. That
hidden network may not accept this booster, so the internet can drop. A
normal install does neither.

The LAN address is the one already set by pre-booster. This installer
keeps that address. Ethernet WAN stays in place until Wi-Fi backhaul
is verified. It also turns off unused services, including WPS
and UPnP, and removes them from the cards. The only de-telstra command
still needed is the hostname and domain name.

-U downloads the latest installer, then applies it. The upstream Wi-Fi,
the backhaul address, and this booster's LAN address stay as they are.
Refresh the browser when it finishes.

Run pre-booster after reset-to-factory-defaults-with-root, de-telstra,
and tch-gui-unhide. Then run this installer.
EOH
exit 1
}

valid_ipv4() {
  echo "$1" | awk -F. '
    NF != 4 { exit 1 }
    {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/) exit 1
        if ($i < 0 || $i > 255) exit 1
      }
    }
  '
}

dja_base() {
  printf '%s\n' "${DJA_BACKHAUL_BASE:-/root/dja-backhaul}"
}

dja_cron() {
  printf '%s\n' "${DJA_CRON_FILE:-/etc/crontabs/root}"
}

# An enabled Scheduled Tasks row does not start with #. A row turned
# off in the web interface stays in the file and starts with #.
sync_cron_active() {
  cron=$(dja_cron)
  [ -f "$cron" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    trim=$(printf '%s' "$line" | sed 's/^[[:space:]]*//')
    case "$trim" in
      ''|'#'*) ;;
      *sync-upstream-ssid*) return 0 ;;
    esac
  done < "$cron"
  return 1
}

remove_hourly_sync() {
  base=$(dja_base)
  cron=$(dja_cron)
  had=n
  if [ -f "$base/sync-ssid" ]; then
    had=y
  fi
  if [ -f "$cron" ] && grep -q 'sync-upstream-ssid' "$cron" 2>/dev/null; then
    had=y
  fi
  rm -f "$base/sync-ssid"
  if [ -f "$cron" ]; then
    : > "$cron.nosync"
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *sync-upstream-ssid*) ;;
        *) printf '%s\n' "$line" >> "$cron.nosync" ;;
      esac
    done < "$cron"
    if cmp -s "$cron.nosync" "$cron"; then
      rm -f "$cron.nosync"
    else
      mv "$cron.nosync" "$cron"
      chmod 600 "$cron"
      if [ -x /etc/init.d/cron ]; then
        /etc/init.d/cron reload >/dev/null 2>&1 || /etc/init.d/cron restart >/dev/null 2>&1 || true
      fi
    fi
  fi
  if [ "$had" = y ]; then
    echo "SSID synchronisation has been disabled. Your current Wi-Fi configuration has been preserved."
  else
    echo "SSID synchronisation is not currently enabled. Nothing to remove."
  fi
}

read_secret() {
  printf '%s' "$1"
  if [ -t 0 ]; then
    stty -echo 2>/dev/null || true
  fi
  IFS= read -r REPLY || REPLY=
  if [ -t 0 ]; then
    stty echo 2>/dev/null || true
    printf '\n'
  fi
}

password_is_mask() {
  [ -n "$1" ] || return 1
  [ "$1" = "Saved – press Enter to keep" ] && return 0
  printf '%s' "$1" | grep -q '^\**$'
}

password_acceptable() {
  n=$(printf '%s' "$1" | wc -c | tr -d ' ')
  printf '%s' "$1" | grep -q '[[:cntrl:]]' && return 1
  printf '%s' "$1" | grep -q "['\"\\\\]" && return 1
  if [ "$n" -ge 8 ] && [ "$n" -le 63 ]; then
    return 0
  fi
  if [ "$n" = 64 ]; then
    printf '%s' "$1" | grep -q '^[0-9A-Fa-f][0-9A-Fa-f]*$'
    return $?
  fi
  return 1
}

one_line_file() {
  [ -f "$1" ] || return 0
  tr -d '\r\n' < "$1"
}

# -S turns a row that Scheduled Tasks has switched off back on.
# The five timing fields on that row are kept. A row that is already
# enabled is left for sync-ssid-cron.sh.
activate_sync_cron() {
  cron=$(dja_cron)
  [ -f "$cron" ] || return 0
  sync_cron_active && return 0
  : > "$cron.on"
  done_one=n
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *sync-upstream-ssid*)
        if [ "$done_one" = n ]; then
          printf '%s\n' "$line" | sed 's/^[[:space:]]*#[[:space:]]*//' >> "$cron.on"
          done_one=y
        fi
        ;;
      *) printf '%s\n' "$line" >> "$cron.on" ;;
    esac
  done < "$cron"
  if cmp -s "$cron.on" "$cron"; then
    rm -f "$cron.on"
    return 0
  fi
  mv "$cron.on" "$cron"
  chmod 600 "$cron"
}

# -Sr is one argument. getopts would otherwise treat it as -S and then -r.
parse_wifi_args() {
  OPTIND=1
  LAN_IP=
  YES=n
  REBOOT=n
  TEST=n
  UPDATE=n
  BOOSTER_CARD=n
  SYNC_ONCE=n
  SYNC_HOUR=n
  SYNC_REMOVE=n
  _args_file=$(mktemp 2>/dev/null || echo "/tmp/wb-args.$$")
  : > "$_args_file"
  for _arg in "$@"; do
    case "$_arg" in
      -Sr) SYNC_REMOVE=y ;;
      *) printf '%s\n' "$_arg" >> "$_args_file" ;;
    esac
  done
  set --
  while IFS= read -r _arg; do
    set -- "$@" "$_arg"
  done < "$_args_file"
  rm -f "$_args_file"
  while getopts :i:nytUbsS option; do
    case "$option" in
      i) LAN_IP=$OPTARG ;;
      n) REBOOT=n ;;
      y) YES=y ;;
      t) TEST=y ;;
      U) UPDATE=y ;;
      b) BOOSTER_CARD=y ;;
      s) SYNC_ONCE=y ;;
      S) SYNC_HOUR=y ;;
      *) usage ;;
    esac
  done
  PARSE_ERROR=
  if [ "$SYNC_REMOVE" = y ]; then
    if [ "$UPDATE" = y ] || [ "$SYNC_HOUR" = y ] || [ "$SYNC_ONCE" = y ] || [ "$BOOSTER_CARD" = y ] || [ -n "$LAN_IP" ] || [ "$TEST" = y ]; then
      PARSE_ERROR=remove-combined
    fi
  fi
}

install_wrapper() {
  wrap=/root/tch-gui-unhide
  if [ ! -f "$wrap" ]; then
    echo -e "${ORANGE}No /root/tch-gui-unhide yet. Run the tch-gui-unhide get command first.${NC}"
    return 0
  fi
  if grep -q dja-backhaul-keep "$wrap"; then
    echo "Unhide upgrade will keep the booster pages."
    return 0
  fi
  mkdir -p /root/dja-backhaul/backups
  cp -p "$wrap" /root/dja-backhaul/backups/tch-gui-unhide.before-keep
  lua - "$wrap" <<'LUA'
local path = arg[1]
local f = io.open(path, "r")
local s = f:read("*a")
f:close()
if s:find("dja-backhaul-keep", 1, true) then
  os.exit(0)
end
local fn = [[
reapply_dja_backhaul() { # dja-backhaul-keep
  src=/root/dja-backhaul/tch-gui-unhide-xtra.dja-backhaul
  dst=/root/tch-gui-unhide-xtra.dja-backhaul
  if [ -f "$src" ] && [ ! -f "$dst" ]; then
    cp "$src" "$dst"
    chmod 755 "$dst"
  fi
  if [ -x /root/dja-backhaul/reapply-after-unhide.sh ]; then
    /root/dja-backhaul/reapply-after-unhide.sh >>/root/dja-backhaul/unhide-reapply.log 2>&1 || true
  fi
}

]]
local first = s:find("\n", 1, true)
if not first then
  io.stderr:write("wrapper has no newline\n")
  os.exit(1)
end
s = s:sub(1, first) .. fn .. s:sub(first + 1)
local out = {}
local n = 0
for line in (s .. "\n"):gmatch("(.-)\n") do
  n = n + 1
  out[n] = line
  if line:find("sh $SCRIPT -W", 1, true) then
    n = n + 1
    out[n] = "  reapply_dja_backhaul"
  end
end
local w = io.open(path, "w")
w:write(table.concat(out, "\n"))
if s:sub(-1) == "\n" then
  w:write("\n")
end
w:close()
LUA
  chmod 755 "$wrap"
  echo "Unhide upgrade will keep the booster pages."
}

# tch-gui-unhide -Cs shows the summary chart by setting
# web.card_Charts.hide to 0. That value is stored in UCI and is what a
# later tch-gui-unhide run reads. Hidden Backhaul Download and Upload
# cards are not this setting: -Cs does not create those cards.
chart_summary_active() {
  [ "$(uci -q get web.card_Charts.hide)" = "0" ]
}

set_card_hide() {
  current=$(uci -q get "web.$1.hide" 2>/dev/null || true)
  if [ "$current" != "$2" ]; then
    uci set "web.$1.hide=$2"
    chart_changed=y
  fi
}

# Fresh installs without a summary chart show the four detail cards.
# A summary chart left by tch-gui-unhide -Cs stays on. That same install
# hides the separate Backhaul Download and Upload cards. CPU and RAM are
# left as they are. An update does not change any card.
apply_chart_visibility() {
  chart_changed=n
  if [ "$UPDATE" = y ]; then
    return 0
  fi
  if chart_summary_active; then
    for card in card_A_BackhaulDown card_B_BackhaulUp; do
      if uci -q get web."$card" >/dev/null 2>&1; then
        set_card_hide "$card" 1
      fi
    done
  else
  for card in card_CPU card_RAM card_A_BackhaulDown card_B_BackhaulUp; do
    if uci -q get web."$card" >/dev/null 2>&1; then
      set_card_hide "$card" 0
    fi
  done
  if uci -q get web.card_Charts >/dev/null 2>&1; then
    set_card_hide card_Charts 1
  fi
  fi
  if [ "$chart_changed" = y ]; then
    uci commit web
    if command -v nginx >/dev/null 2>&1; then
      nginx -s reload >/dev/null 2>&1 || true
    fi
  fi
}

# text is the helper output, code is its exit status, and status_file is
# the live link file. An empty code means the hourly path, where the
# helper runs inside apply-link-flags rather than a second time here.
classify_copy() {
  text=$1
  code=$2
  status_file=$3
  if [ "$code" = 0 ]; then
    if printf '%s\n' "$text" | grep -q 'now use'; then
      echo "Initial Wi-Fi copy: Applied"
      printf '%s\n' "$text" | grep 'now use'
    else
      echo "Initial Wi-Fi copy: Already matched"
    fi
    return 0
  fi
  if [ "$code" = 2 ]; then
    echo "Initial Wi-Fi copy: Pending"
    echo "Reason: The main modem is not connected."
    return 0
  fi
  if [ -n "$code" ]; then
    echo "Initial Wi-Fi copy: Pending"
    echo "Reason: Unable to retrieve the main modem's settings."
    return 0
  fi
  if ! grep -q '^wpa_state=COMPLETED' "$status_file" 2>/dev/null; then
    echo "Initial Wi-Fi copy: Pending"
    echo "Reason: The main modem is not connected."
    return 0
  fi
  if printf '%s\n' "$text" | grep -q 'Could not copy'; then
    echo "Initial Wi-Fi copy: Pending"
    echo "Reason: Unable to retrieve the main modem's settings."
    return 0
  fi
  if printf '%s\n' "$text" | grep -q 'now use'; then
    echo "Initial Wi-Fi copy: Applied"
    printf '%s\n' "$text" | grep 'now use'
  else
    echo "Initial Wi-Fi copy: Already matched"
  fi
}

classify_hidden() {
  text=$1
  pending_flag=$2
  if printf '%s\n' "$text" | grep -q 'Backhaul switched to'; then
    echo "Hidden backhaul: Connection attempt started"
    echo "The Wi-Fi Backhaul card shows whether that network connected."
    return 0
  fi
  if printf '%s\n' "$text" | grep -q 'Could not read the hidden backhaul'; then
    echo "Hidden backhaul: Not started"
    echo "Reason: The hidden network details could not be read. The current network stays."
    return 0
  fi
  if printf '%s\n' "$text" | grep -q 'hidden backhaul details were incomplete'; then
    echo "Hidden backhaul: Not started"
    echo "Reason: The hidden network details were incomplete. The current network stays."
    return 0
  fi
  if [ "$pending_flag" = y ]; then
    echo "Hidden backhaul: Pending"
    echo "Reason: The visible link or the hidden beacon is not ready."
  fi
}

field_or_blank() {
  if [ -n "$1" ]; then
    printf '%s\n' "$1"
  else
    printf '%s\n' "Not set"
  fi
}

load_saved_settings() {
  base=$(dja_base)
  CFG_SSID=$(one_line_file "$base/ssid")
  CFG_BSSID=$(one_line_file "$base/bssid")
  CFG_HAS_PASS=n
  [ -s "$base/password" ] && CFG_HAS_PASS=y
  CFG_PASS_NEW=
  CFG_SSID_TOUCHED=n
  CFG_BSSID_TOUCHED=n
  CFG_IP_TOUCHED=n
  CFG_MODE_TOUCHED=n
  CFG_SYNC_TOUCHED=n
  CFG_LOCAL_TOUCHED=n
  CFG_PASS24_NEW=
  CFG_PASS5_NEW=
  CFG_IP_MODE=dhcp
  CFG_IP=
  CFG_MASK=255.255.255.0
  CFG_GW=
  CFG_DNS1=
  CFG_DNS2=
  if [ -f "$base/backhaul-ip" ]; then
    CFG_IP_MODE=$(sed -n 's/^mode=//p' "$base/backhaul-ip" | head -n 1 | tr -d '\r')
    CFG_IP=$(sed -n 's/^ip=//p' "$base/backhaul-ip" | head -n 1 | tr -d '\r')
    CFG_MASK=$(sed -n 's/^netmask=//p' "$base/backhaul-ip" | head -n 1 | tr -d '\r')
    CFG_GW=$(sed -n 's/^gateway=//p' "$base/backhaul-ip" | head -n 1 | tr -d '\r')
    CFG_DNS1=$(sed -n 's/^dns1=//p' "$base/backhaul-ip" | head -n 1 | tr -d '\r')
    CFG_DNS2=$(sed -n 's/^dns2=//p' "$base/backhaul-ip" | head -n 1 | tr -d '\r')
  fi
  case "$CFG_IP_MODE" in
    dhcp|static) ;;
    *)
      echo "Saved IP mode is not supported and was left unchanged."
      CFG_IP_MODE=dhcp
      ;;
  esac
  [ -n "$CFG_MASK" ] || CFG_MASK=255.255.255.0
  CFG_MODE=standard
  CFG_MODE_KNOWN=y
  if [ -f "$base/backhaul-mode" ]; then
    saved_mode=$(one_line_file "$base/backhaul-mode")
    case "$saved_mode" in
      standard|bh) CFG_MODE=$saved_mode ;;
      *)
        echo "Saved backhaul mode is not supported and was left unchanged."
        CFG_MODE_KNOWN=n
        ;;
    esac
  elif [ -f "$base/backhaul-bh" ]; then
    CFG_MODE=bh
  fi
  if sync_cron_active; then
    CFG_SYNC=enable
  else
    CFG_SYNC=disable
  fi
  if [ -f "$base/sync-ssid" ] && ! sync_cron_active; then
    echo "The synchronisation marker is present, but Scheduled Tasks has no enabled row. Synchronisation is disabled."
  fi
  if sync_cron_active && [ ! -f "$base/sync-ssid" ]; then
    echo "Scheduled Tasks has an enabled synchronisation row. That schedule will be kept."
  fi
  addr_mode=$(one_line_file "$base/client-addressing")
  case "$addr_mode" in
    ''|static|relay-experimental) ;;
    *) echo "Saved downstream addressing is not a supported mode. It was left unchanged." ;;
  esac
  CFG_SSID24=
  CFG_SSID5=
  CFG_HAS_PASS24=n
  CFG_HAS_PASS5=n
  CFG_LOCAL_READ=n
  if command -v uci >/dev/null 2>&1; then
    CFG_SSID24=$(uci -q get wireless.wl0.ssid 2>/dev/null | tr -d '\r') || CFG_SSID24=
    CFG_SSID5=$(uci -q get wireless.wl1.ssid 2>/dev/null | tr -d '\r') || CFG_SSID5=
    if [ -n "$(uci -q get wireless.ap0.wpa_psk_key 2>/dev/null | tr -d '\r')" ]; then
      CFG_HAS_PASS24=y
    fi
    if [ -n "$(uci -q get wireless.ap2.wpa_psk_key 2>/dev/null | tr -d '\r')" ]; then
      CFG_HAS_PASS5=y
    fi
    if [ -n "$CFG_SSID24" ] || [ -n "$CFG_SSID5" ] || [ "$CFG_HAS_PASS24" = y ] || [ "$CFG_HAS_PASS5" = y ]; then
      CFG_LOCAL_READ=y
    fi
  fi
}

mode_label() {
  if [ "$CFG_MODE_KNOWN" != y ]; then
    printf '%s\n' "Unsupported saved mode"
  elif [ "$CFG_MODE" = bh ]; then
    printf '%s\n' "BH backhaul"
  else
    printf '%s\n' "Standard Wi-Fi"
  fi
}

ip_label() {
  if [ "$CFG_IP_MODE" = static ]; then
    printf '%s\n' "Static"
  else
    printf '%s\n' "DHCP"
  fi
}

sync_label() {
  if [ "$CFG_SYNC" = enable ]; then
    printf '%s\n' "Enabled"
  else
    printf '%s\n' "Disabled"
  fi
}

show_saved_settings() {
  echo "  Upstream SSID: $(field_or_blank "$CFG_SSID")"
  if [ -n "$CFG_BSSID" ]; then
    echo "  Upstream BSSID: $CFG_BSSID"
  else
    echo "  Upstream BSSID: Any"
  fi
  if [ "$CFG_HAS_PASS" = y ]; then
    echo "  Upstream password: Saved"
  else
    echo "  Upstream password: Not set"
  fi
  echo "  Wireless station: 5 GHz radio, interface wl1_3"
  echo "  Backhaul mode: $(mode_label)"
  if [ "$CFG_LOCAL_READ" = y ]; then
    echo "  Booster 2.4 GHz SSID: $(field_or_blank "$CFG_SSID24")"
    echo "  Booster 5 GHz SSID: $(field_or_blank "$CFG_SSID5")"
    if [ "$CFG_HAS_PASS24" = y ] || [ "$CFG_HAS_PASS5" = y ]; then
      echo "  Booster Wi-Fi password: Saved"
    else
      echo "  Booster Wi-Fi password: Not set"
    fi
  else
    echo "  Booster Wi-Fi: Left unchanged. The local SSID could not be read."
  fi
  echo "  IP mode: $(ip_label)"
  if [ "$CFG_IP_MODE" = static ] || [ -n "$CFG_IP" ]; then
    echo "  Static IP address: $(field_or_blank "$CFG_IP")"
    echo "  Subnet mask: $(field_or_blank "$CFG_MASK")"
    echo "  Gateway: $(field_or_blank "$CFG_GW")"
    echo "  DNS: $(field_or_blank "$CFG_DNS1") $(field_or_blank "$CFG_DNS2")"
  fi
  if [ "$SYNC_HOUR" = y ]; then
    echo "  SSID synchronisation: Enabled"
  else
    echo "  SSID synchronisation: $(sync_label)"
  fi
  base=$(dja_base)
  live=$(sed -n 's/^ssid=//p' /tmp/dja-backhaul/status-live 2>/dev/null | head -n 1 | tr -d '\r')
  if [ -n "$live" ] && [ -n "$CFG_SSID" ] && [ "$live" != "$CFG_SSID" ]; then
    echo "  The connected SSID is $live. The saved SSID is $CFG_SSID. Enter keeps the saved SSID."
  fi
}

ask_line() {
  printf '%s' "$1"
  IFS= read -r REPLY || REPLY=
}

keep_or_new_text() {
  # $1 current. Empty reply keeps it. Sets REPLY to the value to store.
  current=$1
  entered=$REPLY
  if [ -z "$entered" ]; then
    REPLY=$current
    return 0
  fi
  printf '%s' "$entered" | grep -q '[[:cntrl:]]' && return 1
  REPLY=$entered
}

review_saved_config() {
  load_saved_settings
  show_saved_settings
  [ "$YES" = y ] && return 0
  if [ -n "$CFG_SSID" ]; then
    ask_line "Upstream SSID [$CFG_SSID]: "
  else
    ask_line "Upstream SSID: "
  fi
  if keep_or_new_text "$CFG_SSID"; then
    if [ "$REPLY" != "$CFG_SSID" ]; then
      CFG_SSID=$REPLY
      CFG_SSID_TOUCHED=y
    fi
  else
    echo "That SSID was not saved. The existing SSID is unchanged."
  fi
  if [ "$CFG_HAS_PASS" = y ]; then
    read_secret "Upstream password [Saved – press Enter to keep]: "
  else
    read_secret "Upstream password: "
  fi
  if [ -n "$REPLY" ]; then
    if password_is_mask "$REPLY" || ! password_acceptable "$REPLY"; then
      echo "That password was not saved. The existing password is unchanged."
    else
      CFG_PASS_NEW=$(mktemp 2>/dev/null || echo "/tmp/wb-pass.$$")
      umask 077
      printf '%s' "$REPLY" > "$CFG_PASS_NEW"
      chmod 600 "$CFG_PASS_NEW"
    fi
  fi
  REPLY=
  if [ -n "$CFG_BSSID" ]; then
    ask_line "Upstream BSSID [$CFG_BSSID] (none clears it): "
  else
    ask_line "Upstream BSSID [any]: "
  fi
  if [ "$REPLY" = none ]; then
    CFG_BSSID=
    CFG_BSSID_TOUCHED=y
  elif [ -n "$REPLY" ] && [ "$REPLY" != any ]; then
    case "$REPLY" in
      [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f])
        CFG_BSSID=$REPLY
        CFG_BSSID_TOUCHED=y
        ;;
      *) echo "That BSSID was not saved. The existing BSSID is unchanged." ;;
    esac
  fi
  if [ "$CFG_MODE_KNOWN" = y ]; then
    ask_line "Backhaul mode [$(mode_label)]: "
    choice=$REPLY
    if [ -n "$choice" ]; then
      lower=$(printf '%s' "$choice" | tr 'A-Z' 'a-z')
      case "$lower" in
        standard|standard\ wi-fi|wifi|wi-fi)
          [ "$CFG_MODE" = standard ] || CFG_MODE_TOUCHED=y
          CFG_MODE=standard
          ;;
        bh|bh\ backhaul|backhaul)
          [ "$CFG_MODE" = bh ] || CFG_MODE_TOUCHED=y
          CFG_MODE=bh
          ;;
        *) echo "That backhaul mode was not saved. The existing mode is unchanged." ;;
      esac
    fi
  fi
  if [ "$CFG_LOCAL_READ" = y ]; then
    if [ "$CFG_SYNC" = enable ] || [ "$SYNC_HOUR" = y ]; then
      echo "SSID synchronisation manages the booster Wi-Fi names. A change here lasts until the next check."
    fi
    ask_line "Booster 2.4 GHz SSID [$(field_or_blank "$CFG_SSID24")]: "
    if [ -n "$REPLY" ]; then
      if keep_or_new_text "$CFG_SSID24"; then
        case "$REPLY" in
          *\'*|*\\*) echo "That booster SSID was not saved." ;;
          *)
            CFG_SSID24=$REPLY
            CFG_LOCAL_TOUCHED=y
            ;;
        esac
      else
        echo "That booster SSID was not saved."
      fi
    fi
    ask_line "Booster 5 GHz SSID [$(field_or_blank "$CFG_SSID5")]: "
    if [ -n "$REPLY" ]; then
      if keep_or_new_text "$CFG_SSID5"; then
        case "$REPLY" in
          *\'*|*\\*) echo "That booster SSID was not saved." ;;
          *)
            CFG_SSID5=$REPLY
            CFG_LOCAL_TOUCHED=y
            ;;
        esac
      else
        echo "That booster SSID was not saved."
      fi
    fi
    if [ "$CFG_HAS_PASS24" = y ]; then
      read_secret "Booster 2.4 GHz password [Saved – press Enter to keep]: "
    else
      read_secret "Booster 2.4 GHz password: "
    fi
    if [ -n "$REPLY" ]; then
      if password_is_mask "$REPLY" || ! password_acceptable "$REPLY"; then
        echo "That booster password was not saved."
      else
        CFG_PASS24_NEW=$(mktemp 2>/dev/null || echo "/tmp/wb-pass24.$$")
        umask 077
        printf '%s' "$REPLY" > "$CFG_PASS24_NEW"
        chmod 600 "$CFG_PASS24_NEW"
        CFG_LOCAL_TOUCHED=y
      fi
    fi
    if [ "$CFG_HAS_PASS24" = y ] && [ "$CFG_HAS_PASS5" = y ]; then
      same_local=n
      p24=$(uci -q get wireless.ap0.wpa_psk_key 2>/dev/null | tr -d '\r')
      p5=$(uci -q get wireless.ap2.wpa_psk_key 2>/dev/null | tr -d '\r')
      [ "$p24" = "$p5" ] && same_local=y
      unset p24 p5
    else
      same_local=n
    fi
    if [ "$same_local" != y ]; then
      if [ "$CFG_HAS_PASS5" = y ]; then
        read_secret "Booster 5 GHz password [Saved – press Enter to keep]: "
      else
        read_secret "Booster 5 GHz password: "
      fi
      if [ -n "$REPLY" ]; then
        if password_is_mask "$REPLY" || ! password_acceptable "$REPLY"; then
          echo "That booster password was not saved."
        else
          CFG_PASS5_NEW=$(mktemp 2>/dev/null || echo "/tmp/wb-pass5.$$")
          umask 077
          printf '%s' "$REPLY" > "$CFG_PASS5_NEW"
          chmod 600 "$CFG_PASS5_NEW"
          CFG_LOCAL_TOUCHED=y
        fi
      fi
    fi
  fi
  ask_line "IP mode [$(ip_label)]: "
  if [ -n "$REPLY" ]; then
    lower=$(printf '%s' "$REPLY" | tr 'A-Z' 'a-z')
    case "$lower" in
      dhcp|automatic)
        [ "$CFG_IP_MODE" = dhcp ] || CFG_IP_TOUCHED=y
        CFG_IP_MODE=dhcp
        ;;
      static|static\ ip)
        [ "$CFG_IP_MODE" = static ] || CFG_IP_TOUCHED=y
        CFG_IP_MODE=static
        ;;
      *) echo "That IP mode was not saved. The existing mode is unchanged." ;;
    esac
  fi
  if [ "$CFG_IP_MODE" = static ]; then
    ask_line "Static IP address [$(field_or_blank "$CFG_IP")]: "
    if [ -n "$REPLY" ]; then
      if valid_ipv4 "$REPLY"; then
        CFG_IP=$REPLY
        CFG_IP_TOUCHED=y
      else
        echo "That IP address was not saved. The existing address is unchanged."
      fi
    fi
    ask_line "Subnet mask [$(field_or_blank "$CFG_MASK")]: "
    if [ -n "$REPLY" ] && [ "$REPLY" != "$CFG_MASK" ]; then
      if [ "$REPLY" = 255.255.255.0 ]; then
        CFG_MASK=$REPLY
        CFG_IP_TOUCHED=y
      else
        echo "Only subnet mask 255.255.255.0 is supported. The existing mask is unchanged."
      fi
    fi
    ask_line "Gateway [$(field_or_blank "$CFG_GW")]: "
    if [ -n "$REPLY" ]; then
      if valid_ipv4 "$REPLY"; then
        CFG_GW=$REPLY
        CFG_IP_TOUCHED=y
      else
        echo "That gateway was not saved. The existing gateway is unchanged."
      fi
    fi
    ask_line "Primary DNS [$(field_or_blank "$CFG_DNS1")]: "
    if [ "$REPLY" = none ]; then
      CFG_DNS1=
      CFG_IP_TOUCHED=y
    elif [ -n "$REPLY" ]; then
      if valid_ipv4 "$REPLY"; then
        CFG_DNS1=$REPLY
        CFG_IP_TOUCHED=y
      else
        echo "That DNS server was not saved. The existing DNS server is unchanged."
      fi
    fi
    ask_line "Secondary DNS [$(field_or_blank "$CFG_DNS2")]: "
    if [ "$REPLY" = none ]; then
      CFG_DNS2=
      CFG_IP_TOUCHED=y
    elif [ -n "$REPLY" ]; then
      if valid_ipv4 "$REPLY"; then
        CFG_DNS2=$REPLY
        CFG_IP_TOUCHED=y
      else
        echo "That DNS server was not saved. The existing DNS server is unchanged."
      fi
    fi
  fi
  if [ "$SYNC_HOUR" != y ]; then
    ask_line "SSID synchronisation [$(sync_label)]: "
    if [ -n "$REPLY" ]; then
      lower=$(printf '%s' "$REPLY" | tr 'A-Z' 'a-z')
      case "$lower" in
        enable|enabled|on|yes)
          CFG_SYNC=enable
          CFG_SYNC_TOUCHED=y
          ;;
        disable|disabled|off|no)
          CFG_SYNC=disable
          CFG_SYNC_TOUCHED=y
          ;;
        *) echo "That synchronisation choice was not saved. The existing schedule is unchanged." ;;
      esac
    fi
  else
    CFG_SYNC=enable
  fi
  REPLY=
}

apply_reviewed_settings() {
  base=$(dja_base)
  if [ "$CFG_SSID_TOUCHED" = y ] && [ -n "$CFG_SSID" ]; then
    printf '%s' "$CFG_SSID" > "$base/ssid"
    chmod 600 "$base/ssid"
  fi
  if [ -n "$CFG_PASS_NEW" ] && [ -f "$CFG_PASS_NEW" ]; then
    mv "$CFG_PASS_NEW" "$base/password"
    chmod 600 "$base/password"
    CFG_PASS_NEW=
  fi
  if [ "$CFG_BSSID_TOUCHED" = y ]; then
    if [ -n "$CFG_BSSID" ]; then
      printf '%s' "$CFG_BSSID" > "$base/bssid"
    else
      : > "$base/bssid"
    fi
    chmod 600 "$base/bssid"
  fi
  if [ "$CFG_MODE_KNOWN" = y ] && { [ "$CFG_MODE_TOUCHED" = y ] || [ ! -f "$base/backhaul-mode" ]; }; then
    if [ "$CFG_MODE" = bh ] || [ "$CFG_MODE" = standard ]; then
      printf '%s\n' "$CFG_MODE" > "$base/backhaul-mode"
      chmod 644 "$base/backhaul-mode"
    fi
  fi
  if [ "$CFG_IP_TOUCHED" = y ]; then
    tmp_ip="$base/backhaul-ip.new.$$"
    {
      printf 'mode=%s\n' "$CFG_IP_MODE"
      printf 'ip=%s\n' "$CFG_IP"
      printf 'netmask=%s\n' "$CFG_MASK"
      printf 'gateway=%s\n' "$CFG_GW"
      printf 'dns1=%s\n' "$CFG_DNS1"
      printf 'dns2=%s\n' "$CFG_DNS2"
    } > "$tmp_ip"
    chmod 644 "$tmp_ip"
    mv "$tmp_ip" "$base/backhaul-ip"
  fi
  if [ "$CFG_LOCAL_TOUCHED" = y ] && command -v uci >/dev/null 2>&1; then
    batch="$base/.local-batch.$$"
    : > "$batch"
    chmod 600 "$batch"
    if [ -n "$CFG_SSID24" ]; then
      printf "set wireless.wl0.ssid='%s'\n" "$CFG_SSID24" >> "$batch"
    fi
    if [ -n "$CFG_SSID5" ]; then
      printf "set wireless.wl1.ssid='%s'\n" "$CFG_SSID5" >> "$batch"
    fi
    if [ -n "$CFG_PASS24_NEW" ] && [ -f "$CFG_PASS24_NEW" ]; then
      printf "set wireless.ap0.wpa_psk_key='%s'\n" "$(cat "$CFG_PASS24_NEW")" >> "$batch"
    fi
    if [ -n "$CFG_PASS5_NEW" ] && [ -f "$CFG_PASS5_NEW" ]; then
      printf "set wireless.ap2.wpa_psk_key='%s'\n" "$(cat "$CFG_PASS5_NEW")" >> "$batch"
    elif [ -n "$CFG_PASS24_NEW" ] && [ -f "$CFG_PASS24_NEW" ] && [ "$CFG_HAS_PASS24" = y ] && [ "$CFG_HAS_PASS5" = y ]; then
      p24=$(uci -q get wireless.ap0.wpa_psk_key 2>/dev/null | tr -d '\r')
      p5=$(uci -q get wireless.ap2.wpa_psk_key 2>/dev/null | tr -d '\r')
      if [ "$p24" = "$p5" ]; then
        printf "set wireless.ap2.wpa_psk_key='%s'\n" "$(cat "$CFG_PASS24_NEW")" >> "$batch"
      fi
      unset p24 p5
    fi
    if [ -s "$batch" ]; then
      if uci -f "$batch" batch && uci commit wireless; then
        LOCAL_WIFI_CHANGED=y
      else
        uci revert wireless >/dev/null 2>&1 || true
        echo "The booster Wi-Fi change was not saved."
      fi
    fi
    rm -f "$batch" "$CFG_PASS24_NEW" "$CFG_PASS5_NEW"
    CFG_PASS24_NEW=
    CFG_PASS5_NEW=
  fi
}

if [ "${WIFI_BACKHAUL_LIB_ONLY:-}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

parse_wifi_args "$@"
if [ "$PARSE_ERROR" = remove-combined ]; then
  echo -e "${RED}SSID synchronisation removal cannot be combined with -U, -S, -s, -b, -i or -t.${NC}"
  echo "Run ./wifi-backhaul -Sr on its own."
  exit 1
fi

if [ "$UPDATE" = y ]; then
  REBOOT=n
fi

if [ -n "$LAN_IP" ] && ! valid_ipv4 "$LAN_IP"; then
  echo -e "${RED}Invalid LAN address: $LAN_IP${NC}"
  exit 1
fi
if [ "$(id -u)" != 0 ]; then
  echo -e "${RED}Run this as root on the booster.${NC}"
  exit 1
fi

if [ "$SYNC_REMOVE" = y ] && [ "$UPDATE" != y ]; then
  remove_hourly_sync
  exit 0
fi

if [ "$UPDATE" = y ] && [ "$WIFI_BACKHAUL_FETCHED" != 1 ] && [ "$TEST" != y ]; then
  dest=$(mktemp /tmp/wifi-backhaul.XXXXXX 2>/dev/null) || dest=/tmp/wifi-backhaul.update.$$
  url=https://raw.githubusercontent.com/kavie87/wifi-backhaul/main/wifi-backhaul
  echo "Downloading the latest installer."
  if curl -skL --max-time 90 -o "$dest" "$url" \
    && [ -s "$dest" ] \
    && head -n 1 "$dest" | grep -q '^#!/bin/sh' \
    && grep -q WIFI_BACKHAUL_FETCHED "$dest"; then
    chmod 755 "$dest"
    if cmp -s "$dest" "$0" 2>/dev/null; then
      echo "This installer is already the latest."
      rm -f "$dest"
    else
      echo "Applying the downloaded installer."
      WIFI_BACKHAUL_FETCHED=1
      export WIFI_BACKHAUL_FETCHED
      set -- -U
      [ "$YES" = y ] && set -- "$@" -y
      [ "$BOOSTER_CARD" = y ] && set -- "$@" -b
      [ "$SYNC_ONCE" = y ] && set -- "$@" -s
      [ "$SYNC_HOUR" = y ] && set -- "$@" -S
      [ -n "$LAN_IP" ] && set -- "$@" -i "$LAN_IP"
      exec "$dest" "$@"
      echo -e "${RED}Could not start the downloaded installer.${NC}"
      exit 1
    fi
  else
    echo -e "${ORANGE}Could not download a newer installer. Applying this copy.${NC}"
    rm -f "$dest"
  fi
fi

if [ -z "$LAN_IP" ]; then
  LAN_IP=$(uci -q get network.lan.ipaddr)
fi
if [ "$TEST" != y ] && { [ -z "$LAN_IP" ] || ! valid_ipv4 "$LAN_IP"; }; then
  echo -e "${RED}This modem has no LAN address yet. Run ./pre-booster first.${NC}"
