  fi
done
for s in mmpbxfwctl mmpbxd mmpbxd_lite mmpbxbrcmdect samba minidlna dlnad vsftpd p910nd cupsd cups qos sqm parental parentalcontrol tod webfilter urlfilter miniupnpd miniupnpd-tch intercept ddns mobiled lte-doctor-logger xdsl pppoe-relay pppoe-relay-tch; do
  if [ -x /etc/init.d/$s ]; then
    /etc/init.d/$s stop >/dev/null 2>&1 || true
    /etc/init.d/$s disable >/dev/null 2>&1 || true
  fi
done

install_wrapper
if [ "$BOOSTER_CARD" = y ]; then
  : > /root/dja-backhaul/booster-card
elif [ "$UPDATE" != y ]; then
  rm -f /root/dja-backhaul/booster-card
fi
if [ "$SYNC_SSID" = y ]; then
  : > /root/dja-backhaul/sync-ssid
  if [ "$BOOSTER_CARD" = y ]; then
    : > /root/dja-backhaul/backhaul-bh
  else
    rm -f /root/dja-backhaul/backhaul-bh
  fi
elif [ "$UPDATE" != y ]; then
  rm -f /root/dja-backhaul/sync-ssid /root/dja-backhaul/backhaul-bh
fi
/root/dja-backhaul/restore-webui.sh --once || true

if [ "$UPDATE" != y ]; then
  # CPU, RAM, backhaul download, and backhaul upload.
  # ./tch-gui-unhide -Cs replaces these four with the summary card.
  for card in card_CPU card_RAM card_A_BackhaulDown card_B_BackhaulUp; do
    if uci -q get web."$card" >/dev/null 2>&1; then
      uci set web."$card".hide='0'
    fi
  done
  if uci -q get web.card_Charts >/dev/null 2>&1; then
    uci set web.card_Charts.hide='1'
  fi
  uci commit web
  nginx -s reload >/dev/null 2>&1 || true
fi

if [ -f "$0" ]; then
  cp "$0" /root/wifi-backhaul
  chmod 755 /root/wifi-backhaul
fi

rm -rf "$tmp"
sync
if [ "$UPDATE" = y ]; then
  pid=$(ps w | grep -E '/root/dja-backhaul/web-control.sh|/root/dja-backhaul/backhaul-status-monitor.lua' | grep -v grep | awk '{print $1}')
  if [ -n "$pid" ]; then
    kill $pid 2>/dev/null || true
  fi
  echo -e "${GREEN}Wi-Fi backhaul is updated.${NC}"
  echo "Browse to http://$LAN_IP/ and refresh the page."
  if [ "$SYNC_SSID" != y ] || [ "$BOOSTER_CARD" != y ]; then
    echo "The upstream Wi-Fi and the backhaul address were kept."
  fi
else
  echo -e "${GREEN}Wi-Fi backhaul is installed.${NC}"
  echo "Browse to http://$LAN_IP/ and refresh the page."
  echo "The WAN port is now a LAN port. Leave the cable in place if it runs to the main modem."
  echo "It gives out two addresses, one for a LAN port and one for Wi-Fi. Renew the computer address."
  echo "WPS, UPnP, sharing, telephony, and NAT helpers are off, and removed from the cards."
  echo "Mobile, DNS, Firewall, xDSL, NAT Helpers, and Relay Setup are removed from Management."
  echo "Eco Settings, Diagnostics, Packages, and System Extras are hidden. Management can turn them on."
  echo "Open http://$LAN_IP/ and connect the Wi-Fi backhaul."
  echo "When that link is up, unplug the cable and move this booster."
  if [ ! -s /root/dja-backhaul/ssid ] || [ ! -s /root/dja-backhaul/password ]; then
    echo "Open the Wi-Fi Backhaul card and choose the upstream network."
  fi
  echo "Restarting services. The modem stays up."
  echo "The connection may drop. Wait a couple of minutes for the network to come back up."
  ifdown wan >/dev/null 2>&1 || true
  ifdown wan6 >/dev/null 2>&1 || true
  brctl addif br-lan eth4 >/dev/null 2>&1 || true
  if [ "$old_lan" != "$LAN_IP" ] || [ "$old_mask" != "$applied_mask" ]; then
    /etc/init.d/network reload >/dev/null 2>&1 || true
  fi
  /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
  /etc/init.d/hostapd reload >/dev/null 2>&1 || true
  nginx -s reload >/dev/null 2>&1 || true
  /etc/init.d/dja-backhaul start >/dev/null 2>&1 || true
fi

if [ -x /root/dja-backhaul/apply-link-flags ]; then
  /root/dja-backhaul/apply-link-flags || true
fi
if [ -f /root/dja-backhaul/sync-ssid ]; then
  echo "The 2.4 and 5 GHz copy waits until this booster is connected to the upstream modem."
fi
if [ -f /root/dja-backhaul/backhaul-bh ]; then
  echo "The hidden backhaul is used once that connection is up."
fi
