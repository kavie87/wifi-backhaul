#!/bin/sh
# Wi-Fi backhaul installer for a Telstra DJA0231 that is already rooted,
# de-telstra'd, and running tch-gui-unhide.
#
#   chmod +x wifi-backhaul
#   ./wifi-backhaul -y
#
# The LAN address is the one already set by pre-booster.
# The upstream Wi-Fi name and password are not stored in this file.
# After it finishes, choose the upstream network in the Wi-Fi Backhaul card.
# ./tch-gui-unhide -U -y keeps these pages. Run ./wifi-backhaul -U -y
# to apply a newer copy of this installer without changing the saved
# upstream Wi-Fi, backhaul address, or this booster's LAN address.
# Run the full install again if you replace /root/tch-gui-unhide itself.

SCRIPT="$(basename "$0")"
GREEN='\033[1;32m'
ORANGE='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
cat <<EOH
Installs or updates the Wi-Fi backhaul booster on this device.

Usage: ./$SCRIPT [-y]
       ./$SCRIPT -b [-y]
       ./$SCRIPT -s [-y]
       ./$SCRIPT -bs [-y]
       ./$SCRIPT -U [-b] [-s] [-y]

Options:
 -U           Update an existing booster and keep its saved settings
 -b           Add the Wi-Fi Booster card. A normal install leaves it out
 -s           Copy the upstream 2.4 and 5 GHz names and passwords
 -y           Skip the confirmation prompt
 -n           Accepted. The install does not reboot anyway
 -t           Check the packaged files, then exit

Example:
  ./$SCRIPT -y
  ./$SCRIPT -b -y
  ./$SCRIPT -s -y
  ./$SCRIPT -bs -y
  ./$SCRIPT -U -y

-s copies the modem this booster is connected to. Its 2.4 GHz and 5 GHz
client names and passwords become this booster's client names and
passwords. The backhaul network stays as it is. -bs does that copy and
then aims the backhaul at the main modem's hidden network. That hidden
network may not accept this booster, so the internet can drop. A normal
install does neither.

The LAN address is the one already set by pre-booster. This installer
keeps that address. It also turns off unused services, including WPS
and UPnP, and removes them from the cards. The only de-telstra command
still needed is the hostname and domain name.

-U downloads the latest installer, then applies it. The upstream Wi-Fi,
the backhaul address, and this booster's LAN address stay as they are.
It does not reboot. Refresh the browser when it finishes.

Run pre-booster after reset-to-factory-defaults-with-root, de-telstra,
and tch-gui-unhide. Then run this installer.
EOH
exit 1
}

valid_ipv4() {
  echo "$1" | awk -F. '
    NF != 4 { exit 1 }
    {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/) exit 1
        if ($i < 0 || $i > 255) exit 1
      }
    }
  '
}

install_wrapper() {
  wrap=/root/tch-gui-unhide
  if [ ! -f "$wrap" ]; then
    echo -e "${ORANGE}No /root/tch-gui-unhide yet. Run the tch-gui-unhide get command first.${NC}"
    return 0
  fi
  if grep -q dja-backhaul-keep "$wrap"; then
    echo "Unhide upgrade will keep the booster pages."
    return 0
  fi
  mkdir -p /root/dja-backhaul/backups
  cp -p "$wrap" /root/dja-backhaul/backups/tch-gui-unhide.before-keep
  lua - "$wrap" <<'LUA'
local path = arg[1]
local f = io.open(path, "r")
local s = f:read("*a")
f:close()
if s:find("dja-backhaul-keep", 1, true) then
  os.exit(0)
end
local fn = [[
reapply_dja_backhaul() { # dja-backhaul-keep
  src=/root/dja-backhaul/tch-gui-unhide-xtra.dja-backhaul
  dst=/root/tch-gui-unhide-xtra.dja-backhaul
  if [ -f "$src" ] && [ ! -f "$dst" ]; then
    cp "$src" "$dst"
    chmod 755 "$dst"
  fi
  if [ -x /root/dja-backhaul/reapply-after-unhide.sh ]; then
    /root/dja-backhaul/reapply-after-unhide.sh >>/root/dja-backhaul/unhide-reapply.log 2>&1 || true
  fi
}

]]
local first = s:find("\n", 1, true)
if not first then
  io.stderr:write("wrapper has no newline\n")
  os.exit(1)
end
s = s:sub(1, first) .. fn .. s:sub(first + 1)
local out = {}
local n = 0
for line in (s .. "\n"):gmatch("(.-)\n") do
  n = n + 1
  out[n] = line
  if line:find("sh $SCRIPT -W", 1, true) then
    n = n + 1
    out[n] = "  reapply_dja_backhaul"
  end
end
local w = io.open(path, "w")
w:write(table.concat(out, "\n"))
if s:sub(-1) == "\n" then
  w:write("\n")
end
w:close()
LUA
  chmod 755 "$wrap"
  echo "Unhide upgrade will keep the booster pages."
}

LAN_IP=
YES=n
REBOOT=n
TEST=n
UPDATE=n
BOOSTER_CARD=n
SYNC_SSID=n
while getopts :i:nytUbs option; do
  case "$option" in
    i) LAN_IP=$OPTARG ;;
    n) REBOOT=n ;;
    y) YES=y ;;
    t) TEST=y ;;
    U) UPDATE=y ;;
    b) BOOSTER_CARD=y ;;
    s) SYNC_SSID=y ;;
    *) usage ;;
  esac
done

if [ "$UPDATE" = y ]; then
  REBOOT=n
fi

if [ -n "$LAN_IP" ] && ! valid_ipv4 "$LAN_IP"; then
  echo -e "${RED}Invalid LAN address: $LAN_IP${NC}"
  exit 1
fi
if [ "$(id -u)" != 0 ]; then
  echo -e "${RED}Run this as root on the booster.${NC}"
  exit 1
fi

if [ "$UPDATE" = y ] && [ "$WIFI_BACKHAUL_FETCHED" != 1 ] && [ "$TEST" != y ]; then
  dest=/tmp/wifi-backhaul.update
  url=https://raw.githubusercontent.com/kavie87/wifi-backhaul/main/wifi-backhaul
  echo "Downloading the latest installer."
  rm -f "$dest"
  if curl -skL --max-time 90 -o "$dest" "$url" \
    && [ -s "$dest" ] \
    && head -n 1 "$dest" | grep -q '^#!/bin/sh' \
    && grep -q WIFI_BACKHAUL_FETCHED "$dest"; then
    chmod 755 "$dest"
    if cmp -s "$dest" "$0" 2>/dev/null; then
      echo "This installer is already the latest."
    else
      echo "Applying the downloaded installer."
      WIFI_BACKHAUL_FETCHED=1
      export WIFI_BACKHAUL_FETCHED
      set -- -U
      [ "$YES" = y ] && set -- "$@" -y
      [ "$BOOSTER_CARD" = y ] && set -- "$@" -b
      [ "$SYNC_SSID" = y ] && set -- "$@" -s
      [ -n "$LAN_IP" ] && set -- "$@" -i "$LAN_IP"
      exec "$dest" "$@"
      echo -e "${RED}Could not start the downloaded installer.${NC}"
      exit 1
    fi
  else
    echo -e "${ORANGE}Could not download a newer installer. Applying this copy.${NC}"
    rm -f "$dest"
  fi
fi

if [ -z "$LAN_IP" ]; then
  LAN_IP=$(uci -q get network.lan.ipaddr)
fi
if [ "$TEST" != y ] && { [ -z "$LAN_IP" ] || ! valid_ipv4 "$LAN_IP"; }; then
  echo -e "${RED}This modem has no LAN address yet. Run ./pre-booster first.${NC}"
  exit 1
fi

