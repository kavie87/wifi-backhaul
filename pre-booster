#!/bin/sh
# Move the booster modem onto the same network as the main modem.
# Check that the LAN address is free before using it.
#
# Direct LAN move:
#   ./pre-booster -i 192.168.100.4 -y
#
# Wired first, like a shop booster. Plug the WAN port into the main modem.
# This waits until that modem gives the WAN port an address, checks the
# chosen LAN address is on that network, and saves it. The WAN session
# stays up. ./wifi-backhaul then turns the WAN port into a LAN port,
# and the Wi-Fi backhaul is connected from the page. Unplug and move
# the booster after that link is up.
#
#   ./pre-booster -w -i 192.168.100.4 -y

SCRIPT="$(basename "$0")"
GREEN='\033[1;32m'
ORANGE='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

# tch-gui-unhide -Cs shows the summary chart by setting
# web.card_Charts.hide to 0. That value is stored in UCI and is what a
# later tch-gui-unhide run reads. Hidden Backhaul Download and Upload
# cards are not this setting: -Cs does not create those cards.
chart_summary_active() {
  [ "$(uci -q get web.card_Charts.hide)" = "0" ]
}

usage() {
cat <<EOH
Moves the booster modem onto the same network as the main modem.
Check that the LAN address is free before you use it.

Usage: ./$SCRIPT -i <lan-ip> [-y]
       ./$SCRIPT -w -i <lan-ip> [-y]

Options:
 -i <lan-ip>  IPv4 address for this modem on the main modem's LAN
 -w           Wait until the WAN port receives an address from the main modem
 -y           Skip the confirmation prompt

Check that the LAN address is free. On a 192.168.100.0 network the main
modem is 192.168.100.1, so this booster needs another free address.

Without -w, this restarts the network and DHCP.
DHCP stays on so a computer can pick up an address on the new network.
You may need to reconnect the LAN or WAN cables.

With -w, plug the WAN port into a LAN port on the main modem first.
The script waits for an address from that modem, then saves the LAN
address. It does not drop the WAN connection. Run ./wifi-backhaul -y
next. When the Wi-Fi backhaul is up, unplug the cable and move the booster.

Examples:
  ./$SCRIPT -i 192.168.100.4 -y
  ./$SCRIPT -w -i 192.168.100.4 -y

After ./wifi-backhaul -y, open http://<lan-ip>/ and connect the Wi-Fi backhaul.
EOH
exit 1
}

valid_ipv4() {
  echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
  old_ifs=$IFS
  IFS=.
  set -- $1
  IFS=$old_ifs
  [ $# -eq 4 ] || return 1
  for part in "$1" "$2" "$3" "$4"; do
    [ "$part" -ge 0 ] 2>/dev/null && [ "$part" -le 255 ] || return 1
  done
  return 0
}

prefix_to_mask() {
  bits=$1
  out=
  i=0
  while [ "$i" -lt 4 ]; do
    if [ "$bits" -ge 8 ]; then
      octet=255
      bits=$((bits - 8))
    else
      case $bits in
        0) octet=0 ;;
        1) octet=128 ;;
        2) octet=192 ;;
        3) octet=224 ;;
        4) octet=240 ;;
        5) octet=248 ;;
        6) octet=252 ;;
        7) octet=254 ;;
        *) return 1 ;;
      esac
      bits=0
    fi
    if [ -z "$out" ]; then
      out=$octet
    else
      out=$out.$octet
    fi
    i=$((i + 1))
  done
  printf '%s\n' "$out"
}

same_subnet() {
  ip=$1
  other=$2
  mask=$3
  old_ifs=$IFS
  IFS=.
  set -- $ip
  a1=$1
  a2=$2
  a3=$3
  a4=$4
  set -- $other
  b1=$1
  b2=$2
  b3=$3
  b4=$4
  set -- $mask
  m1=$1
  m2=$2
  m3=$3
  m4=$4
  IFS=$old_ifs
  [ $((a1 & m1)) -eq $((b1 & m1)) ] &&
    [ $((a2 & m2)) -eq $((b2 & m2)) ] &&
    [ $((a3 & m3)) -eq $((b3 & m3)) ] &&
    [ $((a4 & m4)) -eq $((b4 & m4)) ]
}

read_wan() {
  if [ -n "$PRE_BOOSTER_STATUS" ]; then
    cat "$PRE_BOOSTER_STATUS"
  else
    ifstatus wan 2>/dev/null
  fi | awk '
    /"inactive"/ { exit }
    $1 ~ /"up":/ && $2 ~ /true/ { up = 1 }
    $1 ~ /"l3_device":/ && dev == "" {
      gsub(/[",]/, "", $2)
      dev = $2
    }
    $1 ~ /"ipv4-address"/ { in4 = 1 }
    in4 && $1 ~ /"address":/ && addr == "" {
      gsub(/[",]/, "", $2)
      addr = $2
    }
    in4 && $1 ~ /"mask":/ && mask == "" {
      gsub(/[^0-9]/, "", $2)
      mask = $2
      in4 = 0
    }
    $1 ~ /"target":/ && $2 ~ /0\.0\.0\.0/ { want = 1; next }
    want && $1 ~ /"nexthop":/ && gw == "" {
      gsub(/[",]/, "", $2)
      gw = $2
      want = 0
    }
    END {
      if (up && addr != "" && mask != "" && gw != "")
        print addr, mask, gw, dev
    }
  '
}

address_in_use() {
  dev=$1
  ip=$2
  [ "$PRE_BOOSTER_SKIP_PROBE" = 1 ] && return 1
  command -v arping >/dev/null 2>&1 || return 1
  [ -n "$dev" ] || return 1
  out=/tmp/pre-booster-arping.$$
  arping -D -I "$dev" -c 2 "$ip" >"$out" 2>&1
  code=$?
  if grep -qi 'reply from\|unicast' "$out" 2>/dev/null; then
    rm -f "$out"
    return 0
  fi
  rm -f "$out"
  [ "$code" -eq 0 ] && return 1
  return 1
}

LAN_IP=
YES=n
WIRED=n
while getopts :i:yw option; do
  case "$option" in
    i) LAN_IP=$OPTARG ;;
    y) YES=y ;;
    w) WIRED=y ;;
    *) usage ;;
  esac
done

if [ -z "$LAN_IP" ] || ! valid_ipv4 "$LAN_IP"; then
  echo -e "${RED}A valid LAN address is required. Example: -i 192.168.100.4${NC}"
  usage
fi

WAN_MASK=255.255.255.0
if [ "$WIRED" = y ]; then
  wait_for=${PRE_BOOSTER_WAIT:-300}
  echo -e "${GREEN}Waiting for the main modem to address the WAN port.${NC}"
  echo "Plug the WAN port into a LAN port on the main modem."
  elapsed=0
  WAN_IP=
  while [ "$elapsed" -lt "$wait_for" ]; do
    set -- $(read_wan)
    if [ -n "$1" ] && valid_ipv4 "$1" && valid_ipv4 "$3"; then
      WAN_IP=$1
      WAN_PREFIX=$2
      WAN_GW=$3
      WAN_DEV=$4
      break
    fi
    echo "Still waiting for an address on the WAN port."
    step=5
    left=$((wait_for - elapsed))
    [ "$left" -lt "$step" ] && step=$left
    [ "$step" -gt 0 ] && sleep "$step"
    elapsed=$((elapsed + step))
  done
  if [ -z "$WAN_IP" ]; then
    echo -e "${RED}The WAN port did not receive an address.${NC}"
    echo "Leave it plugged into the main modem and run this again."
    exit 1
  fi
  WAN_MASK=$(prefix_to_mask "$WAN_PREFIX") || {
    echo -e "${RED}The WAN address uses a mask this script cannot apply ($WAN_PREFIX).${NC}"
    exit 1
  }
  echo "WAN address: $WAN_IP/$WAN_PREFIX"
  echo "Main modem:  $WAN_GW"
  if [ "$LAN_IP" = "$WAN_IP" ]; then
    echo -e "${RED}$LAN_IP is the WAN address. Choose a different LAN address.${NC}"
    exit 1
  fi
  if [ "$LAN_IP" = "$WAN_GW" ]; then
    echo -e "${RED}$LAN_IP is the main modem. Choose a different LAN address.${NC}"
    exit 1
  fi
  if ! same_subnet "$LAN_IP" "$WAN_IP" "$WAN_MASK"; then
    echo -e "${RED}$LAN_IP is not on the main modem's network ($WAN_IP/$WAN_PREFIX).${NC}"
    exit 1
  fi
  if address_in_use "$WAN_DEV" "$LAN_IP"; then
    echo -e "${RED}$LAN_IP answered on the main modem's network. Choose a free address.${NC}"
    exit 1
  fi
  if [ "$PRE_BOOSTER_DRY" = 1 ]; then
    echo "DRY wan=$WAN_IP/$WAN_PREFIX gw=$WAN_GW dev=${WAN_DEV:-none} lan=$LAN_IP mask=$WAN_MASK"
    exit 0
  fi
fi

old_lan=$(uci -q get network.lan.ipaddr)
echo
printf '%s\n' '========================================' ' Pre-Booster - Network Preparation' '========================================'
echo "Current configuration:"
printf '  LAN address: %s\n' "${old_lan:-unknown}"
printf '  Requested LAN address: %s\n' "$LAN_IP"
if [ "$WIRED" = y ]; then
  printf '  Wired setup: WAN %s, gateway %s\n' "$WAN_IP" "$WAN_GW"
  echo "  The WAN port stays on the main modem. This WAN session stays up while the LAN address is saved."
else
  echo "  Direct setup: changing the LAN address restarts the network and may drop this SSH session."
fi
if chart_summary_active; then
  echo "Existing summary chart configuration detected."
  echo "Preserving existing chart visibility preferences."
fi
if [ "$old_lan" = "$LAN_IP" ]; then
  echo "Results:"
  echo "  The requested LAN address is already configured."
  echo "Next steps:"
  echo "  Run ./wifi-backhaul -y if it is not installed."
  exit 0
fi

if [ "$YES" != y ]; then
  echo -n "Enter y to continue: "
  read REPLY
  [ "$REPLY" = y ] || [ "$REPLY" = Y ] || exit 0
fi

echo "Applying configuration..."
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$WAN_MASK"
if ! uci commit network; then
  echo "Results:" >&2
  echo "  The LAN address was not saved." >&2
  exit 1
fi
saved_lan=$(uci -q get network.lan.ipaddr)
if [ "$saved_lan" != "$LAN_IP" ]; then
  echo "Results:" >&2
  printf '  The LAN address is still %s.\n' "${saved_lan:-unknown}" >&2
  exit 1
fi

if [ "$WIRED" = y ]; then
  echo "Results:"
  printf '  LAN address %s is saved. The WAN session stays on %s.\n' "$LAN_IP" "$WAN_IP"
  echo "Next steps:"
  echo "  Run ./wifi-backhaul -y"
  exit 0
fi

echo "Restarting the network. This SSH session may drop."
if ! /etc/init.d/network reload; then
  echo "Results:" >&2
  printf '  The network restart did not finish. The saved LAN address is %s.\n' "$LAN_IP" >&2
  exit 1
fi
/etc/init.d/dnsmasq restart || true
echo "Results:"
printf '  LAN address: %s\n' "$LAN_IP"
echo "Next steps:"
printf '  Open http://%s/ and confirm the page loads. Then run ./wifi-backhaul -y\n' "$LAN_IP"
