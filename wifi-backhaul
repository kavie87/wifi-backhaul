    dja-backhaul/known.sh \
    dja-backhaul/webui/cards/010_usb.lp \
    dja-backhaul/webui/modals/usb-backup-modal.lp \
    dja-backhaul/bin/wpa_supplicant \
    init.dja-backhaul \
    tch-gui-unhide-xtra.dja-backhaul \
    restore-fresh-root
  do
    if [ ! -s "$tmp/$need" ]; then
      echo "MISSING $need"
      missing=1
    fi
  done
  if [ -e "$tmp/dja-backhaul/password" ] || [ -e "$tmp/dja-backhaul/ssid" ]; then
    echo "PACKAGE CONTAINS WIFI CREDENTIALS"
    missing=1
  fi
  rm -rf "$tmp"
  if [ "$missing" = 1 ]; then
    echo -e "${RED}Package check failed.${NC}"
    exit 1
  fi
  echo -e "${GREEN}Package check passed. Nothing was installed.${NC}"
  exit 0
fi

if [ "$UPDATE" = y ]; then
  echo -e "${GREEN}This updates the Wi-Fi backhaul booster.${NC}"
  echo "  LAN address: $LAN_IP"
  if [ "$BOOSTER_CARD" = y ] && { [ "$SYNC_HOUR" = y ] || [ "$SYNC_ONCE" = y ]; }; then
    echo "  The local names are copied from the upstream modem."
    echo -e "${ORANGE}The backhaul then tries the hidden network.${NC}"
  else
    echo "  Saved upstream Wi-Fi and the backhaul address are kept."
    echo -e "${ORANGE}The backhaul link stays up.${NC}"
  fi
  echo "Refresh the browser when this finishes."
  if [ "$BOOSTER_CARD" = y ]; then
    echo "The Wi-Fi Booster card will be added."
  fi
  if [ "$SYNC_HOUR" = y ]; then
    echo "The local 2.4 and 5 GHz names will follow the main modem, and be checked every hour."
    echo "Scheduled Tasks lists that job. The time can be changed there."
  elif [ "$SYNC_ONCE" = y ]; then
    echo "The local 2.4 and 5 GHz names will be copied once from the main modem."
    echo "If that modem is not connected, the names stay as they are."
  fi
  if [ "$BOOSTER_CARD" = y ] && { [ "$SYNC_HOUR" = y ] || [ "$SYNC_ONCE" = y ]; }; then
    echo "The backhaul will then try the main modem's hidden network."
    echo "It uses that network's password and beacon address."
    echo "If the internet drops, rejoin the visible network."
  fi
else
  echo -e "${GREEN}This installs the Wi-Fi backhaul booster.${NC}"
  echo "  LAN address: $LAN_IP"
  echo "  That address is already set and is kept."
  echo "  Upstream Wi-Fi is chosen afterwards in the Wi-Fi Backhaul card."
  echo "  A saved upstream network on this device is kept."
  echo "The connection may drop. Wait a couple of minutes for the network to come back up."
  echo "Open http://$LAN_IP/ when it finishes."
  echo "The WAN port becomes a LAN port. Leave that cable in place if it runs to the main modem."
  echo "It then uses a small subnet and gives out two addresses, one for a LAN port and one for Wi-Fi."
  echo "It also turns off unused services: WPS, UPnP, sharing, telephony, and NAT helpers."
  echo "Those are removed from the cards. You do not need de-telstra for that."
  echo "Connect the Wi-Fi backhaul from the page. When that link is up, unplug the cable and move this booster."
  if [ "$BOOSTER_CARD" = y ]; then
    echo "The Wi-Fi Booster card will be added."
  fi
  if [ "$SYNC_HOUR" = y ]; then
    echo "The local 2.4 and 5 GHz names will follow the main modem, and be checked every hour."
    echo "Scheduled Tasks lists that job. The time can be changed there."
  elif [ "$SYNC_ONCE" = y ]; then
    echo "The local 2.4 and 5 GHz names will be copied once from the main modem."
    echo "If that modem is not connected, the names stay as they are."
  fi
  if [ "$BOOSTER_CARD" = y ] && { [ "$SYNC_HOUR" = y ] || [ "$SYNC_ONCE" = y ]; }; then
    echo "The backhaul will then try the main modem's hidden network."
    echo "It uses that network's password and beacon address."
    echo "If the internet drops, rejoin the visible network."
  fi
fi
