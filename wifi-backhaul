    echo -e "${RED}Package check failed.${NC}"
    exit 1
  fi
  echo -e "${GREEN}Package check passed. Nothing was installed.${NC}"
  exit 0
fi

if [ "$UPDATE" = y ]; then
  echo -e "${GREEN}This updates the Wi-Fi backhaul booster.${NC}"
  echo "  LAN address: $LAN_IP"
  echo "  Saved upstream Wi-Fi and the backhaul address are kept."
  echo -e "${ORANGE}It will not reboot, and the backhaul link stays up.${NC}"
  echo "Refresh the browser when this finishes."
else
  echo -e "${GREEN}This installs the Wi-Fi backhaul booster.${NC}"
  echo "  LAN address: $LAN_IP"
  echo "  That address is already set and is kept."
  echo "  Upstream Wi-Fi is chosen afterwards in the Wi-Fi Backhaul card."
  echo "  A saved upstream network on this device is kept."
  echo -e "${ORANGE}It restarts services and does not reboot.${NC}"
  echo "The connection may drop. Wait a couple of minutes for the network to come back up."
  echo "Open http://$LAN_IP/ when it finishes."
  echo "The WAN port becomes a LAN port. Leave that cable in place if it runs to the main modem."
  echo "It then uses a small subnet and gives out two addresses, one for a LAN port and one for Wi-Fi."
  echo "It also turns off unused services: WPS, UPnP, sharing, telephony, and NAT helpers."
  echo "Those are removed from the cards. You do not need de-telstra for that."
  echo "Connect the Wi-Fi backhaul from the page. When that link is up, unplug the cable and move this booster."
fi
if [ "$YES" != y ]; then
  echo -n "Enter y to continue: "
  read REPLY
  [ "$REPLY" = y ] || [ "$REPLY" = Y ] || exit 0
fi

mkdir -p /root/dja-backhaul/backups
for keep in ssid password bssid backhaul-ip; do
  if [ -f /root/dja-backhaul/$keep ]; then
    cp -a /root/dja-backhaul/$keep "$tmp/keep-$keep"
  fi
done

cp -a "$tmp/dja-backhaul/." /root/dja-backhaul/
for keep in ssid password bssid backhaul-ip; do
  if [ -f "$tmp/keep-$keep" ]; then
    cp -a "$tmp/keep-$keep" /root/dja-backhaul/$keep
  fi
done

if [ ! -s /root/dja-backhaul/backhaul-ip ]; then
  cat > /root/dja-backhaul/backhaul-ip <<'EOF'
mode=dhcp
ip=
netmask=255.255.255.0
gateway=
dns1=
dns2=
EOF
  chmod 644 /root/dja-backhaul/backhaul-ip
fi
chmod 600 /root/dja-backhaul/ssid /root/dja-backhaul/password /root/dja-backhaul/bssid 2>/dev/null || true
find /root/dja-backhaul -name '*.sh' -o -name '*.lua' | while read -r script; do
  chmod 755 "$script"
done
chmod 755 /root/dja-backhaul/bin/* 2>/dev/null || true

cp "$tmp/init.dja-backhaul" /etc/init.d/dja-backhaul
chmod 755 /etc/init.d/dja-backhaul
/etc/init.d/dja-backhaul enable

cp "$tmp/tch-gui-unhide-xtra.dja-backhaul" /root/tch-gui-unhide-xtra.dja-backhaul
cp "$tmp/tch-gui-unhide-xtra.dja-backhaul" /root/dja-backhaul/tch-gui-unhide-xtra.dja-backhaul
chmod 755 /root/tch-gui-unhide-xtra.dja-backhaul /root/dja-backhaul/tch-gui-unhide-xtra.dja-backhaul

if [ -x /root/dja-backhaul/rfkill-button.sh ]; then
  cp /root/dja-backhaul/rfkill-button.sh /etc/rc.button/rfkill
  chmod 755 /etc/rc.button/rfkill
fi

old_lan=$(uci -q get network.lan.ipaddr)
old_mask=$(uci -q get network.lan.netmask)
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.ipv6='0'
uci set network.lan.ifname='eth0 eth1 eth2 eth3 eth4'
uci -q delete network.wan.ifname
uci set network.wan.proto='none'
uci set network.wan.auto='0'
uci -q delete network.wan6.ifname
uci set network.wan6.auto='0'
applied_mask=255.255.255.0
if [ "$UPDATE" != y ]; then
  o=${LAN_IP##*.}
  rem4=$((o % 4))
  if [ "$rem4" -eq 1 ] || [ "$rem4" -eq 2 ]; then
    applied_mask=255.255.255.252
    base=$((o - rem4))
    if [ "$rem4" -eq 1 ]; then
      pool=$((base + 2))
    else
      pool=$((base + 1))
    fi
    dhcp_start=$((pool - base))
    dhcp_limit=1
  else
    applied_mask=255.255.255.248
    rem8=$((o % 8))
    base=$((o - rem8))
    pool=$((o + 1))
    if [ "$pool" -gt $((base + 6)) ]; then
      pool=$((base + 1))
    fi
    dhcp_start=$((pool - base))
    dhcp_limit=1
    second=$((base + dhcp_start + 1))
    if [ "$second" -le $((base + 6)) ] && [ "$second" -ne "$o" ]; then
      dhcp_limit=2
    fi
  fi
  printf '%s\n' "$applied_mask" > /root/dja-backhaul/waiting-netmask
  printf '%s %s\n' "$dhcp_start" "$dhcp_limit" > /root/dja-backhaul/waiting-dhcp
  uci set dhcp.lan.ignore='0'
  uci set dhcp.lan.dhcpv4='server'
  uci set dhcp.lan.start="$dhcp_start"
  uci set dhcp.lan.limit="$dhcp_limit"
  uci commit dhcp
fi
uci set network.lan.netmask="$applied_mask"
uci commit network

uci set button.wifi_onoff=button
uci set button.wifi_onoff.button='BTN_1'
uci set button.wifi_onoff.action='released'
uci set button.wifi_onoff.min='0'
uci set button.wifi_onoff.max='10'
uci set button.wifi_onoff.handler='/root/dja-backhaul/wifi-button.lua'
uci commit button

uci set wireless.wl1_2.state='0'
uci set wireless.ap4.state='0'
# WPS off on local access points. Guest and EasyMesh backhaul names are left alone.
for ap in $(uci show wireless | awk -F= '/^wireless\.[^=]+=wifi-ap$/{print $1}' | awk -F. '{print $2}'); do
  case "$ap" in
    *=*) continue ;;
  esac
  ssid=$(uci -q get "wireless.$ap.ssid")
  case "$ssid" in
    *Guest*|*guest*|BH-*) continue ;;
  esac
  uci -q set "wireless.$ap.wps_state=0"
done
uci commit wireless

uci -q set upnpd.config.enable_upnp='0'
uci -q set upnpd.config.enable_natpmp='0'
uci commit upnpd
uci -q set dlnad.config.enabled='0'
uci commit dlnad
uci -q set printersharing.config.enabled='0'
uci commit printersharing
uci -q set samba.samba.filesharing='0'
uci commit samba
uci -q set mmpbx.global.enabled='0'
uci -q set mmpbx.dectemission.state='0'
uci commit mmpbx
uci -q set intercept.config.enabled='0'
uci commit intercept
uci -q set ledfw.syslog.trace='0'
uci commit ledfw
if uci -q show nfc >/dev/null 2>&1; then
  uci -q set nfc.@nfc[0].enabled='0'
  uci commit nfc
fi
lan_zone=$(uci show firewall | awk -F. "/@zone/ && /name='lan'/{print \$1\".\"\$2; exit}")
wan_zone=$(uci show firewall | awk -F. "/@zone/ && /wan='1'/{print \$1\".\"\$2; exit}")
if [ -n "$lan_zone" ]; then
  uci -q delete "$lan_zone.helper"
fi
if [ -n "$wan_zone" ]; then
  uci -q delete "$wan_zone.helper"
fi
uci commit firewall

if [ -x /etc/init.d/mmpbxfwctl ]; then
  /etc/init.d/mmpbxfwctl stop >/dev/null 2>&1 || true
  /etc/init.d/mmpbxfwctl disable >/dev/null 2>&1 || true
fi
uci -q set mobiled.device_defaults.enabled='0'
uci -q set mobiled.platform.power_on='0'
uci commit mobiled

for card in card_eco card_diagnostics card_opkg card_system; do
  if uci -q get web."$card" >/dev/null 2>&1; then
    uci set web."$card".hide='1'
  fi
done
for s in mmpbxfwctl mmpbxd mmpbxd_lite mmpbxbrcmdect samba minidlna dlnad vsftpd p910nd cupsd cups qos sqm parental parentalcontrol tod webfilter urlfilter miniupnpd miniupnpd-tch intercept ddns mobiled lte-doctor-logger xdsl pppoe-relay pppoe-relay-tch; do
  if [ -x /etc/init.d/$s ]; then
    /etc/init.d/$s stop >/dev/null 2>&1 || true
    /etc/init.d/$s disable >/dev/null 2>&1 || true
  fi
done

install_wrapper
/root/dja-backhaul/restore-webui.sh --once || true

if [ "$UPDATE" != y ]; then
  # CPU, RAM, backhaul download, and backhaul upload.
  # ./tch-gui-unhide -Cs replaces these four with the summary card.
  for card in card_CPU card_RAM card_A_BackhaulDown card_B_BackhaulUp; do
    if uci -q get web."$card" >/dev/null 2>&1; then
      uci set web."$card".hide='0'
    fi
  done
  if uci -q get web.card_Charts >/dev/null 2>&1; then
    uci set web.card_Charts.hide='1'
  fi
  uci commit web
  nginx -s reload >/dev/null 2>&1 || true
fi

if [ -f "$0" ]; then
  cp "$0" /root/wifi-backhaul
  chmod 755 /root/wifi-backhaul
fi

rm -rf "$tmp"
sync
if [ "$UPDATE" = y ]; then
  pid=$(ps w | grep -E '/root/dja-backhaul/web-control.sh|/root/dja-backhaul/backhaul-status-monitor.lua' | grep -v grep | awk '{print $1}')
  if [ -n "$pid" ]; then
    kill $pid 2>/dev/null || true
  fi
  echo -e "${GREEN}Wi-Fi backhaul is updated.${NC}"
  echo "Browse to http://$LAN_IP/ and refresh the page."
  echo "The upstream Wi-Fi and the backhaul address were kept."
else
  echo -e "${GREEN}Wi-Fi backhaul is installed.${NC}"
  echo "Browse to http://$LAN_IP/ and refresh the page."
  echo "The WAN port is now a LAN port. Leave the cable in place if it runs to the main modem."
  echo "It gives out two addresses, one for a LAN port and one for Wi-Fi. Renew the computer address."
  echo "WPS, UPnP, sharing, telephony, and NAT helpers are off, and removed from the cards."
  echo "Mobile, DNS, Firewall, xDSL, NAT Helpers, and Relay Setup are removed from Management."
  echo "Eco Settings, Diagnostics, Packages, and System Extras are hidden. Management can turn them on."
  echo "Open http://$LAN_IP/ and connect the Wi-Fi backhaul."
  echo "When that link is up, unplug the cable and move this booster."
  if [ ! -s /root/dja-backhaul/ssid ] || [ ! -s /root/dja-backhaul/password ]; then
    echo "Open the Wi-Fi Backhaul card and choose the upstream network."
  fi
  echo "Restarting services. The modem stays up."
  echo "The connection may drop. Wait a couple of minutes for the network to come back up."
  ifdown wan >/dev/null 2>&1 || true
  ifdown wan6 >/dev/null 2>&1 || true
  brctl addif br-lan eth4 >/dev/null 2>&1 || true
  if [ "$old_lan" != "$LAN_IP" ] || [ "$old_mask" != "$applied_mask" ]; then
    /etc/init.d/network reload >/dev/null 2>&1 || true
  fi
  /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
  /etc/init.d/hostapd reload >/dev/null 2>&1 || true
  nginx -s reload >/dev/null 2>&1 || true
  /etc/init.d/dja-backhaul start >/dev/null 2>&1 || true
fi
